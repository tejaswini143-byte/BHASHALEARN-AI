# Copy to .env and fill locally. NEVER commit your real key.
GNANI_API_KEY=replace_me
# Confirm your endpoint and authentication header in the GNANI developer dashboard.
GNANI_STT_URL=
GNANI_AUTH_HEADER=X-API-Key-ID
# Optional request form fields; confirm values against your account's API docs.
GNANI_LANGUAGE=indic-auto
GNANI_OUTPUT_FORMAT=codemix
GNANI_TIMEOUT_SECONDS=45
