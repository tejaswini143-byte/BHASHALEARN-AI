# Optional POC-06 overrides; existing POC-01/02/03 .env files are also loaded.
# Never commit a real .env or paste credentials into chat.
GNANI_API_KEY=replace_me
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE=indic-auto
GNANI_OUTPUT_FORMAT=codemix
GNANI_TIMEOUT_SECONDS=60
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=
GNANI_TTS_TIMEOUT_SECONDS=60
LLM_API_KEY=replace_me
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=45
POC06_SAMPLE_RATE=16000
POC06_CHANNELS=1
POC06_RECORDING_SECONDS=5
POC06_MAX_RECORDING_SECONDS=30
POC06_AUDIO_OUTPUT_DIR=pocs/poc06_bilingual_voice/artifacts

