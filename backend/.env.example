# Canonical local configuration: copy this file to the repository root .env.
# Process environment variables override .env values. Never commit real secrets.
BHASHALEARN_APP_NAME=BHASHALEARN AI API
BHASHALEARN_APP_ENV=development
BHASHALEARN_DEBUG=false
BHASHALEARN_API_PREFIX=/api/v1
BHASHALEARN_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/YOUR_DB_NAME
BHASHALEARN_JWT_SECRET_KEY=replace-with-a-long-random-development-secret
# Optional server-side Gemini tutor configuration. Never put provider keys in VITE_* variables.
BHASHALEARN_GEMINI_API_KEY=replace-with-your-Gemini-API-key
BHASHALEARN_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional documented Brave Search API. Without it, research uses labeled offline fixtures.
BHASHALEARN_BRAVE_SEARCH_API_KEY=replace-with-your-Brave-Search-subscription-token
BHASHALEARN_RESEARCH_REQUESTS_PER_MINUTE=10
# Used for explicit document indexing and semantic search. If blank, the backend
# falls back to BHASHALEARN_GEMINI_API_KEY. This key is server-only.
BHASHALEARN_GEMINI_EMBEDDING_API_KEY=replace-with-your-Gemini-API-key
BHASHALEARN_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
BHASHALEARN_GEMINI_EMBEDDING_DIMENSIONS=768
BHASHALEARN_EMBEDDING_CHUNK_SIZE=1000
BHASHALEARN_EMBEDDING_CHUNK_OVERLAP=150
BHASHALEARN_EMBEDDING_TIMEOUT_SECONDS=20
BHASHALEARN_EMBEDDING_MAX_RETRIES=2
BHASHALEARN_DOCUMENT_STORAGE_DIR=backend/storage/documents
BHASHALEARN_DOCUMENT_MAX_UPLOAD_BYTES=10485760
BHASHALEARN_DOCUMENT_MAX_PAGES=100
BHASHALEARN_DOCUMENT_MAX_EXTRACTED_CHARACTERS=2000000
BHASHALEARN_DOCUMENT_MAX_FILENAME_LENGTH=255
# Gnani Prisma STT and Timbre TTS use these server-side variables.
# Process environment overrides the root .env; legacy POC-local .env files are
# fallback-only for standalone POC compatibility.
GNANI_API_KEY=replace_me
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE=indic-auto
GNANI_OUTPUT_FORMAT=codemix
GNANI_TIMEOUT_SECONDS=60
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=
GNANI_TTS_TIMEOUT_SECONDS=60

# Personal assistant provider operations are disabled by default. Configure
# only when an administrator has authorized the specific integration.
BHASHALEARN_ASSISTANT_TOKEN_ENCRYPTION_KEY=
BHASHALEARN_ASSISTANT_PUBLIC_BASE_URL=
BHASHALEARN_GOOGLE_OAUTH_CLIENT_ID=
BHASHALEARN_GOOGLE_OAUTH_CLIENT_SECRET=
BHASHALEARN_GOOGLE_OAUTH_REDIRECT_URI=
BHASHALEARN_ASSISTANT_GOOGLE_LIVE_ENABLED=false
BHASHALEARN_ASSISTANT_LIVE_OPERATIONS_ENABLED=false
BHASHALEARN_TWILIO_LIVE_CALLS_ENABLED=false
BHASHALEARN_TWILIO_ACCOUNT_SID=
BHASHALEARN_TWILIO_AUTH_TOKEN=
BHASHALEARN_TWILIO_FROM_NUMBER=
BHASHALEARN_TWILIO_VERIFY_SERVICE_SID=
BHASHALEARN_TWILIO_STATUS_CALLBACK_URL=
BHASHALEARN_TWILIO_ALLOWED_DESTINATION_PREFIXES=
BHASHALEARN_ASSISTANT_MAX_CALLS_PER_DAY=3
