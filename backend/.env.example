# Copy to the repository root .env for local development; do not commit real secrets.
BHASHALEARN_APP_NAME=BHASHALEARN AI API
BHASHALEARN_APP_ENV=development
BHASHALEARN_DEBUG=false
BHASHALEARN_API_PREFIX=/api/v1
BHASHALEARN_DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@localhost:5432/bhashalearn
BHASHALEARN_JWT_SECRET_KEY=replace-with-a-long-random-development-secret
# Optional server-side Gemini tutor configuration. Never put provider keys in VITE_* variables.
BHASHALEARN_GEMINI_API_KEY=replace-with-your-Gemini-API-key
BHASHALEARN_GEMINI_MODEL=gemini-2.5-flash
BHASHALEARN_DOCUMENT_STORAGE_DIR=backend/storage/documents
BHASHALEARN_DOCUMENT_MAX_UPLOAD_BYTES=10485760
BHASHALEARN_DOCUMENT_MAX_PAGES=100
BHASHALEARN_DOCUMENT_MAX_EXTRACTED_CHARACTERS=2000000
BHASHALEARN_DOCUMENT_MAX_FILENAME_LENGTH=255
# Gnani Prisma STT and Timbre TTS are configured from these server-side values.
# Existing POC .env files are also loaded when a value is not set here.
GNANI_API_KEY=replace_me
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE=indic-auto
GNANI_OUTPUT_FORMAT=codemix
GNANI_TIMEOUT_SECONDS=60
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=
GNANI_TTS_TIMEOUT_SECONDS=60
